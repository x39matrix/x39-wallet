<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ni copia en la nube ni transferencia entre dispositivos para la billetera. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="x39-wallet" />
        <exclude domain="database" path="x39-wallet" />
        <exclude domain="sharedpref" path="x39-wallet.xml" />
        <exclude domain="file" path="x39-wallet-mainnet" />
        <exclude domain="database" path="x39-wallet-mainnet" />
        <exclude domain="sharedpref" path="x39-wallet-mainnet.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="x39-wallet" />
        <exclude domain="database" path="x39-wallet" />
        <exclude domain="sharedpref" path="x39-wallet.xml" />
        <exclude domain="file" path="x39-wallet-mainnet" />
        <exclude domain="database" path="x39-wallet-mainnet" />
        <exclude domain="sharedpref" path="x39-wallet-mainnet.xml" />
    </device-transfer>
</data-extraction-rules>
